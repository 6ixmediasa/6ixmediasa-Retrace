<Window x:Class="Retrace.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Retrace" Height="860" Width="1500" MinHeight="760" MinWidth="1200"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBg}">
    <Window.Resources>
        <DataTemplate x:Key="EventTemplate">
            <Border BorderBrush="#1D3146" BorderThickness="0,0,0,1" Padding="8,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource Muted}" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="1" Text="{Binding Type}" Foreground="#6EB5FF" FontWeight="SemiBold" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Path}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="3" Content="View" Tag="{Binding Path}" Click="ViewPath_Click" Style="{StaticResource ToolbarButton}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RecoveryEventTemplate">
            <Border BorderBrush="#1D3146" BorderThickness="0,0,0,1" Padding="8,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Type}" Foreground="#6EB5FF" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Path}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding RecoveryLabel}" Foreground="{Binding RecoveryColor}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border Margin="20" CornerRadius="18" Background="{StaticResource Bg}" BorderBrush="#20456C" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="2,4,0,28">
                        <TextBlock Text="Retrace" FontSize="30" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Your computer remembers." Foreground="{StaticResource Muted}" Margin="2,4,0,0" FontSize="12"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Button x:Name="NavHomeButton" Style="{StaticResource NavButton}" Content="Home" Click="Home_Click" Background="#102742" BorderBrush="#183F66"/>
                        <Button x:Name="NavRecoverButton" Style="{StaticResource NavButton}" Content="Recover" Click="Recover_Click"/>
                        <Button x:Name="NavFindButton" Style="{StaticResource NavButton}" Content="Find" Click="Find_Click"/>
                        <Button x:Name="NavExplainButton" Style="{StaticResource NavButton}" Content="Explain" Click="Explain_Click"/>
                        <Button x:Name="NavResumeButton" Style="{StaticResource NavButton}" Content="Resume" Click="Resume_Click"/>
                        <Button x:Name="NavFinishButton" Style="{StaticResource NavButton}" Content="Finish" Click="Finish_Click"/>
                        <Separator/>
                        <Button x:Name="NavTimelineButton" Style="{StaticResource NavButton}" Content="Timeline" Click="Timeline_Click"/>
                        <Button x:Name="NavSnapshotsButton" Style="{StaticResource NavButton}" Content="Snapshots" Click="Snapshots_Click"/>
                        <Separator/>
                        <Button x:Name="NavSettingsButton" Style="{StaticResource NavButton}" Content="Settings" Click="Settings_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <Border Style="{StaticResource CardStyle}" Background="#0E2034" BorderBrush="#214160" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="ProtectionText" Text="Monitoring active" Foreground="{StaticResource Success}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="WatchCountText" Text="0 folders watched" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Background="#0C1624">
                    <Grid Margin="20,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="+ New Snapshot" Style="{StaticResource PrimaryButton}" Click="QuickSnapshot_Click"/>
                        <Button Grid.Column="1" Content="Recover Selected" Style="{StaticResource ToolbarButton}" Click="Recover_Click"/>
                        <TextBox Grid.Column="2" x:Name="TopSearchBox" Margin="14,0,14,0" Height="40" VerticalContentAlignment="Center" Text="Search events, files, paths..."/>
                        <Button Grid.Column="3" x:Name="MonitoringToggleButton" Content="Monitoring Active" Style="{StaticResource ToolbarButton}" Click="ToggleProtection_Click" Background="#0E2A1A" BorderBrush="#276647"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="20">
                    <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="What do you want to fix?" FontSize="32" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="Undo recent changes, recover deleted files, or see what happened." Foreground="{StaticResource Muted}" Margin="0,6,0,16" HorizontalAlignment="Center"/>
                            <Grid HorizontalAlignment="Center" Width="760">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="CommandBox" Height="50" VerticalContentAlignment="Center" KeyDown="CommandBox_KeyDown"/>
                                <Button Grid.Column="1" Content="Retrace" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="RunCommand_Click"/>
                            </Grid>
                            <WrapPanel Margin="0,12,0,24" HorizontalAlignment="Center">
                                <Button Content="Undo my last 5 minutes" Click="Suggestion_Click"/>
                                <Button Content="Recover deleted files today" Click="Suggestion_Click"/>
                                <Button Content="Show recent changes" Click="Suggestion_Click"/>
                            </WrapPanel>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.05*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,14,14">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="Recent Activity" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                                            <Button Content="Refresh" DockPanel.Dock="Right" Click="Refresh_Click" Style="{StaticResource ToolbarButton}"/>
                                        </DockPanel>
                                        <ListBox x:Name="RecentList" Margin="0,12,0,0" ItemTemplate="{StaticResource EventTemplate}" SelectionChanged="EventList_SelectionChanged"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,14,14">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="Recover Summary" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock Text="Last 24h" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/>
                                        </DockPanel>
                                        <UniformGrid Columns="3" Margin="0,18,0,18">
                                            <StackPanel>
                                                <TextBlock x:Name="SummaryChangesTrackedText" Text="0" FontSize="30" FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock Text="Changes Tracked" Foreground="{StaticResource Muted}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock x:Name="SummaryFilesChangedText" Text="0" FontSize="30" FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock Text="Files Changed" Foreground="{StaticResource Muted}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock x:Name="SummaryIssuesText" Text="0" FontSize="30" FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock Text="Issues Detected" Foreground="{StaticResource Muted}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                        <TextBlock Text="Quick Reverse" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <Button Content="Undo Last Change" Click="SelectFive_Click"/>
                                        <Button Content="Undo Last 10 Changes" Click="SelectHour_Click" Margin="0,8,0,0"/>
                                        <Button Content="Undo Since Last Snapshot" Click="Recover_Click" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="Snapshots" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                                            <Button Content="View all" DockPanel.Dock="Right" Click="Snapshots_Click" Style="{StaticResource ToolbarButton}"/>
                                        </DockPanel>
                                        <ListBox x:Name="HomeSnapshotsList" Margin="0,12,0,0" SelectionChanged="SnapshotList_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#1D3146" BorderThickness="0,0,0,1" Padding="6,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding DisplayDate}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="Saved" Foreground="{StaticResource Success}" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,14,0">
                                    <StackPanel>
                                        <TextBlock Text="Explain" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="Why did this happen?" Foreground="{StaticResource Muted}" Margin="0,10,0,12"/>
                                        <TextBlock x:Name="ExplainSummaryText" Text="Retrace will correlate your recent file activity here so you can quickly understand what changed." TextWrapping="Wrap" Foreground="#D2DEEA" FontSize="14" LineHeight="22"/>
                                        <DockPanel Margin="0,20,0,0">
                                            <TextBlock Text="Confidence" Foreground="White" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="ExplainConfidenceText" Text="92%" DockPanel.Dock="Right" Foreground="{StaticResource Success}" FontSize="28" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <ProgressBar x:Name="ExplainConfidenceBar" Minimum="0" Maximum="100" Value="92" Height="7" Margin="0,10,0,0" Foreground="{StaticResource Success}" Background="#142536"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,14,0">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="Timeline" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock Text="Last 24 Hours" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/>
                                        </DockPanel>
                                        <Border Margin="0,14,0,10" Background="#0B1521" CornerRadius="12" BorderBrush="#1B2D40" BorderThickness="1" Padding="12">
                                            <Canvas Height="180">
                                                <Polyline Stroke="#3B8FFF" StrokeThickness="3" Points="6,146 42,112 76,125 110,136 144,104 178,94 212,102 246,136 280,128 314,96 348,114 382,68 416,118"/>
                                                <Ellipse Width="8" Height="8" Fill="#3B8FFF" Canvas.Left="38" Canvas.Top="108"/>
                                                <Ellipse Width="8" Height="8" Fill="#3B8FFF" Canvas.Left="174" Canvas.Top="90"/>
                                                <Ellipse Width="8" Height="8" Fill="#54D48E" Canvas.Left="242" Canvas.Top="132"/>
                                                <Ellipse Width="8" Height="8" Fill="#FF6B6B" Canvas.Left="308" Canvas.Top="92"/>
                                                <Ellipse Width="8" Height="8" Fill="#B17CFF" Canvas.Left="378" Canvas.Top="64"/>
                                            </Canvas>
                                        </Border>
                                        <WrapPanel>
                                            <TextBlock Text="• File Changes" Foreground="#63AAFF" Margin="0,0,14,0"/>
                                            <TextBlock Text="• Deletions" Foreground="#FF7D7D" Margin="0,0,14,0"/>
                                            <TextBlock Text="• Restores" Foreground="#66DCA0" Margin="0,0,14,0"/>
                                            <TextBlock Text="• Snapshots" Foreground="#BA8CFF"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Quick Actions" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>
                                        <UniformGrid Columns="2" Rows="2">
                                            <Button Content="Recover Changes" Height="84" Click="Recover_Click" Margin="0,0,8,8"/>
                                            <Button Content="View Timeline" Height="84" Click="Timeline_Click" Margin="0,0,0,8"/>
                                            <Button Content="Create Snapshot" Height="84" Click="QuickSnapshot_Click" Margin="0,0,8,0"/>
                                            <Button Content="Take Me There" Height="84" Click="EventDetailsView_Click" Margin="0,0,0,0"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="TimelinePage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Timeline" FontSize="30" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="A chronological memory of recorded file changes." Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                            <Button Content="Refresh" DockPanel.Dock="Right" Click="Refresh_Click" Style="{StaticResource ToolbarButton}"/>
                        </DockPanel>
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                            <ListBox x:Name="TimelineList" ItemTemplate="{StaticResource EventTemplate}" SelectionChanged="EventList_SelectionChanged"/>
                        </Border>
                    </Grid>

                    <Grid x:Name="RecoverPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Recover" FontSize="30" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="Review recorded changes. Items marked Ready can be reversed safely." Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                        <WrapPanel Grid.Row="1" Margin="0,16,0,12">
                            <Button Content="Select last 5 min" Click="SelectFive_Click"/>
                            <Button Content="Select last hour" Click="SelectHour_Click"/>
                            <Button Content="Select all visible" Click="SelectAllRecover_Click"/>
                        </WrapPanel>
                        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                            <ListBox x:Name="RecoverList" SelectionMode="Extended" ItemTemplate="{StaticResource RecoveryEventTemplate}" SelectionChanged="EventList_SelectionChanged"/>
                        </Border>
                        <DockPanel Grid.Row="3" Margin="0,12,0,0">
                            <TextBlock x:Name="RecoverStatus" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <Button Content="Recover Selected" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Click="RecoverSelected_Click"/>
                        </DockPanel>
                    </Grid>

                    <Grid x:Name="FindPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Find" FontSize="30" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="Search by filename, folder, extension, or remembered context." Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,16,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="FindBox" Height="44" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="Search" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="Search_Click"/>
                        </Grid>
                        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                            <ListBox x:Name="FindList" ItemTemplate="{StaticResource EventTemplate}" SelectionChanged="EventList_SelectionChanged"/>
                        </Border>
                    </Grid>

                    <ScrollViewer x:Name="ExplainPage" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Explain" FontSize="30" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="Retrace correlates recent changes to help you understand what changed before a problem." Foreground="{StaticResource Muted}" Margin="0,4,0,18"/>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="What changed recently?" FontSize="20" Foreground="White" FontWeight="SemiBold"/>
                                    <TextBox x:Name="ExplainBox" Margin="0,14,0,12" Height="44" VerticalContentAlignment="Center"/>
                                    <Button Content="Analyse Recent Changes" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="ExplainAnalyse_Click"/>
                                    <TextBlock x:Name="ExplainResult" TextWrapping="Wrap" Foreground="#CAD7E5" Margin="0,18,0,0" FontSize="14" LineHeight="22"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="ComingPage" Visibility="Collapsed">
                        <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="620">
                            <StackPanel>
                                <TextBlock x:Name="ComingTitle" Text="Resume" FontSize="34" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock x:Name="ComingText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="15" Margin="0,12,0,18"/>
                                <TextBlock Text="Retrace V0.2 keeps this mode visible so the final product structure stays in place while the core recovery engine matures." Foreground="#BBD1E8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="SnapshotsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel>
                            <StackPanel>
                                <TextBlock Text="Snapshots" FontSize="30" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Save a known-good state of your watched folders." Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                            <Button Content="+ Create Snapshot" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Click="CreateSnapshot_Click"/>
                        </DockPanel>
                        <TextBox x:Name="SnapshotNameBox" Grid.Row="1" Margin="0,16,0,12" Height="42" VerticalContentAlignment="Center" ToolTip="Snapshot name"/>
                        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                            <ListBox x:Name="SnapshotsList" SelectionChanged="SnapshotList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#1D3146" BorderThickness="0,0,0,1" Padding="8,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding DisplayDate}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Restore" Tag="{Binding Item}" Click="RestoreSnapshot_Click"/>
                                                <Button Grid.Column="2" Content="Delete" Tag="{Binding Item}" Click="DeleteSnapshot_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>

                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="Retrace is local-first. Choose exactly what it is allowed to remember." Foreground="{StaticResource Muted}" Margin="0,4,0,18"/>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Watched folders" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                    <ListBox x:Name="WatchedFoldersList" Margin="0,12,0,12"/>
                                    <WrapPanel>
                                        <Button Content="Add folder" Click="AddFolder_Click"/>
                                        <Button Content="Remove selected" Click="RemoveFolder_Click"/>
                                    </WrapPanel>
                                    <Separator/>
                                    <TextBlock Text="Recovery storage limit (GB)" Foreground="White"/>
                                    <TextBox x:Name="StorageGbBox" Width="100" HorizontalAlignment="Left" Margin="0,8,0,14"/>
                                    <TextBlock Text="History retention (days)" Foreground="White"/>
                                    <TextBox x:Name="HistoryDaysBox" Width="100" HorizontalAlignment="Left" Margin="0,8,0,14"/>
                                    <CheckBox x:Name="StartWindowsCheck" Content="Start Retrace with Windows"/>
                                    <CheckBox x:Name="TrayCheck" Content="Keep Retrace running in the system tray when I close the window" Margin="0,5,0,16"/>
                                    <Button Content="Save Settings" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="SaveSettings_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Background="#0C1624">
                    <Grid Margin="18,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FooterStatusText" Text="Monitoring • Up to date" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="18,0">
                            <Hyperlink NavigateUri="https://www.6ixmediasa.com" RequestNavigate="SixMediaLink_RequestNavigate" Foreground="#6EB5FF" TextDecorations="None">Crafted with &lt;3 by 6ixMedia SA</Hyperlink>
                        </TextBlock>
                        <TextBlock Grid.Column="2" x:Name="FooterStorageText" Text="Protected storage ready" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2" Background="#0A1522" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0">
                <Grid Margin="18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="Event Details" FontSize="28" FontWeight="SemiBold" Foreground="White"/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,14,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="DetailTitleText" Text="No event selected" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock x:Name="DetailSelectedText" Text="Select an event from Timeline, Recover, Find, or Recent Activity." Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,8">
                                    <TextBlock Text="Event Type" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="DetailTypeText" Text="—" Foreground="White" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock Text="Time" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="DetailTimeText" Text="—" Foreground="White" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Current Path" Foreground="{StaticResource Muted}"/>
                                <TextBlock x:Name="DetailCurrentPathText" Text="—" Foreground="White" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Original Path" Foreground="{StaticResource Muted}"/>
                                <TextBlock x:Name="DetailOriginalPathText" Text="—" Foreground="White" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Recovery Status" Foreground="{StaticResource Muted}"/>
                                <TextBlock x:Name="DetailRecoveryStatusText" Text="—" Foreground="White" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Notes" Foreground="{StaticResource Muted}"/>
                                <TextBlock x:Name="DetailNotesText" Text="—" Foreground="#CAD7E5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button Content="View" Style="{StaticResource PrimaryButton}" Click="EventDetailsView_Click"/>
                        <Button Content="Reverse" Margin="0,8,0,0" Click="EventDetailsReverse_Click"/>
                        <Button Content="Open Recovery Folder" Margin="0,8,0,0" Click="OpenRecoveryFolder_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
